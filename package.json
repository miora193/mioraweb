{
  "name": "mioraweb",
  "private": true,
  "version": "0.1.0",
  "description": "MIORA WEB - portfolio monorepo (React/TypeScript frontend + Strapi CMS)",
  "engines": {
    "node": "20.x || 22.x"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:cms": "turbo run dev --filter=cms",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:cms": "turbo run build --filter=cms",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
