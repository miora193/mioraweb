HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local development uses SQLite by default.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# For production (e.g. Render/Railway), switch to Postgres (Supabase/Neon free tier work well):
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true

# CORS: comma-separated list of frontend origins allowed to call this API.
FRONTEND_URL=http://localhost:5173

# Media uploads: local disk works for development, but free-tier hosts
# (Render, Railway) have an ephemeral filesystem — uploaded files disappear
# on every redeploy. Set these (free Cloudinary account) in production so
# uploads persist. Leave unset locally.
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=
